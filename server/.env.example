# ==========================================================
# Assistive AI Server Configuration (.env)
# ==========================================================

# Server Host & Port
HOST=0.0.0.0
PORT=8000
DEBUG=False

# YOLOv8 Model Configuration
# Model weight path:
# - models/yolov8n.pt (Nano: fastest, lightest ~50-80ms CPU)
# - models/yolov8s.pt (Small: balanced accuracy, recommended ~90-120ms CPU)
# - models/yolov8m.pt (Medium: highest precision, heavier ~200-300ms CPU)
YOLO_MODEL_PATH=models/yolov8s.pt
MODEL_PATH=models/yolov8s.pt

# Minimum confidence threshold to detect an object
CONFIDENCE_THRESHOLD=0.35

# Cautious description threshold:
# If confidence < CONFIDENCE_CERTAIN_THRESHOLD, the system uses cautious wording
# "vật thể" instead of asserting an uncertain specific class name (avoids falsely saying "con bò").
CONFIDENCE_CERTAIN_THRESHOLD=0.50
CAUTIOUS_DESCRIPTION_ENABLED=True

# Device for inference: 'cpu' or 'cuda' (auto-detected if empty)
DEVICE=cpu

# Image & Resource Constraints
MAX_IMAGE_SIZE_MB=5.0
MAX_CONCURRENT_REQUESTS=4
INFERENCE_TIMEOUT_SECONDS=15.0

# Edge-TTS Voice Configuration
TTS_VOICE=vi-VN-HoaiMyNeural
TTS_RATE=+0%
AUDIO_TTL_MINUTES=30
MAX_CONCURRENT_TTS=3
TTS_TIMEOUT_SECONDS=12.0

# Object Prioritization Configuration (Assistive Navigation)
PRIORITY_WEIGHT_BOTTOM=0.45
PRIORITY_WEIGHT_AREA=0.30
PRIORITY_WEIGHT_CENTER=0.25
PRIORITY_EDGE_PENALTY=0.55
PRIORITY_MIN_THRESHOLD=0.15
MAX_SPOKEN_OBJECTS=2

# Optional API Security (Leave empty to disable authentication for testing)
API_KEY=

# ESP32 Real Data Storage Paths
SAVE_DEBUG_IMAGES=True
IMAGE_DIR=data/images
AUDIO_DIR=data/audio
