# ==========================================================
# Assistive AI Server Configuration (.env)
# ==========================================================

# Server Host & Port
HOST=0.0.0.0
PORT=8000
DEBUG=False

# YOLO-World Model Configuration
# Server nạp model bằng YOLOWorld + set_classes(), nên BẮT BUỘC dùng trọng số YOLO-World:
# - models/yolov8s-worldv2.pt (Small, khuyến nghị — tự tải lần chạy đầu)
# - models/yolov8m-worldv2.pt (Medium, chính xác hơn, nặng hơn)
# Không dùng yolov8n.pt / yolov8s.pt thường (không hỗ trợ set_classes).
YOLO_MODEL_PATH=models/yolov8s-worldv2.pt
MODEL_PATH=models/yolov8s-worldv2.pt

# Minimum confidence threshold to detect an object
CONFIDENCE_THRESHOLD=0.35

# Cautious description threshold:
# Below this confidence threshold, speech qualifies the name (e.g. "có thể có một xe máy").
CONFIDENCE_CERTAIN_THRESHOLD=0.50
CAUTIOUS_DESCRIPTION_ENABLED=True

# Device for inference: 'cpu' or 'cuda' (auto-detected if empty)
DEVICE=cpu

# Image & Resource Constraints
MAX_IMAGE_SIZE_MB=5.0
MAX_CONCURRENT_REQUESTS=4
INFERENCE_TIMEOUT_SECONDS=15.0

# Scene assistant (Single Click only)
GEMINI_API_KEY=
SCENE_AI_MODEL=gemini-3.5-flash-lite
SCENE_AI_MEDIA_RESOLUTION=LOW
SCENE_AI_TIMEOUT_SECONDS=12

# Edge-TTS Voice Configuration
TTS_ENGINE=edge
TTS_VOICE=vi-VN-HoaiMyNeural
TTS_RATE=+0%
AUDIO_TTL_MINUTES=30
MAX_CONCURRENT_TTS=3
TTS_TIMEOUT_SECONDS=12.0

# Object Prioritization Configuration (Assistive Navigation)
PRIORITY_WEIGHT_BOTTOM=0.45
PRIORITY_WEIGHT_AREA=0.30
PRIORITY_WEIGHT_CENTER=0.25
PRIORITY_EDGE_PENALTY=0.55
PRIORITY_MIN_THRESHOLD=0.15
MAX_SPOKEN_OBJECTS=2

# OCR Configuration (Chức năng 3: đọc chữ biển hiệu / nhãn đồ vật)
# Engine nhận dạng chữ:
# - auto   : Gemini nếu đã điền GEMINI_API_KEY (đọc tiếng Việt chuẩn hơn), lỗi / thiếu khóa thì EasyOCR
# - gemini : luôn thử Gemini trước (lỗi vẫn quay về EasyOCR)
# - easyocr: chỉ dùng EasyOCR (offline)
OCR_ENGINE=auto
# gemini-3.1-flash-lite: đo trên máy này 2-3 giây/ảnh, ổn định (3.5-flash-lite: 3-19 giây, hay lỗi 503)
OCR_GEMINI_MODEL=gemini-3.1-flash-lite
# LOW / MEDIUM / HIGH: chữ nhỏ bị bỏ sót thì thử HIGH (tốn hạn mức hơn)
OCR_GEMINI_MEDIA_RESOLUTION=MEDIUM
# Quá thời gian này thì chuyển sang EasyOCR
OCR_GEMINI_TIMEOUT_SECONDS=12
# Gemini thỉnh thoảng trả lời chậm bất thường: sau N giây chưa có kết quả thì gửi thêm request song song
OCR_GEMINI_HEDGE_SECONDS=4
OCR_GEMINI_MAX_PARALLEL=3
# --- EasyOCR (dự phòng / offline) ---
# Ngôn ngữ nhận dạng (EasyOCR codes, phân tách bằng dấu phẩy)
OCR_LANGUAGES=vi,en
# Bỏ các đoạn chữ có độ tin cậy thấp hơn ngưỡng này
OCR_MIN_CONFIDENCE=0.30
# Cạnh dài của ảnh trước khi OCR (px): ảnh nhỏ được phóng to (tối đa 2 lần), ảnh lớn thu nhỏ
OCR_MAX_IMAGE_SIDE=1280
# Tăng tương phản CLAHE - chỉ nên bật khi ảnh thiếu sáng / ngược sáng (ảnh ban ngày đọc kém hơn)
OCR_CLAHE=False
# Giới hạn độ dài câu đọc (ký tự) để giọng đọc không quá dài
OCR_MAX_SPOKEN_CHARS=300
# Đoạn chữ dưới ngưỡng này bị bỏ hẳn; từ ngưỡng này tới OCR_MIN_CONFIDENCE là "chữ mờ" (không đọc)
OCR_TIER_MIN_CONFIDENCE=0.15
# 3 mức cỡ chữ (chiều cao so với chữ lớn nhất): Chính >= 0.75, Phụ 0.25-0.75, Chi tiết < 0.25
# (khung chữ của Gemini ôm sát hơn EasyOCR: 'NHÀ THUỐC' chỉ còn ~25% so với 'AN BÌNH')
OCR_TIER_MAIN_RATIO=0.75
OCR_TIER_SUB_RATIO=0.25
# Chữ mức Phụ chỉ đọc khi độ tin cậy >= ngưỡng này
OCR_SUB_MIN_CONFIDENCE=0.50
# Giới hạn số từ của câu đọc biển hiệu / nhãn đồ vật
OCR_SIGN_MAX_WORDS=20
OCR_LABEL_MAX_WORDS=30
# Engine giọng nói cho OCR: 'edge' (Edge-TTS, mặc định) hoặc 'gtts'
OCR_TTS_ENGINE=edge
OCR_TTS_VOICE=vi-VN-HoaiMyNeural

# Optional API Security (Leave empty to disable authentication for testing)
API_KEY=

# ESP32 Real Data Storage Paths
SAVE_DEBUG_IMAGES=True
IMAGE_DIR=data/images
AUDIO_DIR=data/audio
